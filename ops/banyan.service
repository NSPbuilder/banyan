[Unit]
Description=Banyan — finance and business management (Next.js)
Documentation=file:///srv/banyan/README.md
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
# The ledger is the point; never let a restart loop eat the machine.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=banyan
Group=banyan
WorkingDirectory=/srv/banyan
Environment=NODE_ENV=production
Environment=PORT=3000
# next start, not `npm run start`: systemd supervises the real process
# instead of an npm wrapper that has to forward every signal.
ExecStart=/usr/bin/node /srv/banyan/node_modules/next/dist/bin/next start -H 127.0.0.1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=banyan

[Install]
WantedBy=multi-user.target
