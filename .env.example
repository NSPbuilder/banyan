# Banyan uses this one PostgreSQL connection for normal work, migrations and
# superadmin portable restore.
DATABASE_URL=postgresql://banyan@127.0.0.1:5432/banyan_local

# Disposable and provably different from DATABASE_URL.
TEST_DATABASE_URL=postgresql://figtree_test@localhost:5432/figtree_banyan_disposable_test
# Set only after confirming this database is isolated and disposable.
# TEST_DATABASE_CONFIRMATION=figtree_banyan_disposable_test

# A scheduler-readable, access-controlled location for original documents.
ATTACHMENTS_DIR=/absolute/path/to/banyan-attachments
PROJECT_ATTACHMENTS_DIR=/absolute/path/to/banyan-project-attachments

# PostgreSQL client directory when pg_dump/pg_restore are not on PATH.
# PG_BIN=/opt/homebrew/opt/postgresql@17/bin

# Optional assistant-key encryption secret.
# AI_KEY_SECRET=

# Optional TOTP enrollment. Separate from AI encryption; 32 random bytes base64.
# AUTH_MFA_KEY=<dedicated-encryption-key>
# AUTH_ADMIN_MFA_REQUIRED=false
# Trust only a header overwritten by your private reverse proxy. Direct public
# access must be blocked when enabled. Supported: x-real-ip, cf-connecting-ip.
# AUTH_TRUSTED_IP_HEADER=x-real-ip
# Failure budgets in a short persistent window; successes clear account/pair.
# AUTH_PAIR_LIMIT=8
# AUTH_ACCOUNT_LIMIT=20
# AUTH_IP_LIMIT=120
# AUTH_WINDOW_SECONDS=60
# EDIT_LEASE_SECONDS=120
# Public client timings are baked into the build; rebuild after changing them.
# NEXT_PUBLIC_EDIT_HEARTBEAT_SECONDS=30
# NEXT_PUBLIC_EDIT_IDLE_MINUTES=15

## P6 passkeys: opt in only after choosing the permanent HTTPS domain.
PASSKEYS_ENABLED=false
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
## Example RP ID: accounts.example.com; Origin: https://accounts.example.com
## HTTP localhost is accepted only for isolated development/protocol checks.

## MCP read tools and optional draft proposals; see docs/INTEGRATIONS.md.
MCP_ENABLED=false
MCP_PUBLIC_ORIGIN=
# Draft proposal tools also need explicit credential scopes and browser confirmation.
MCP_WRITES_ENABLED=false

## P2: opt-in worker. A scheduler must supply DATABASE_URL explicitly and pass
## --database <exact name>; do not copy the test database into production.
AUTOMATION_ENABLED=false
## SMTP is required only for approved outgoing sends. TLS is required remotely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_TIMEOUT_MS=15000
## Only loopback TCP test capture may opt out of TLS; keep false in deployment.
SMTP_LOCAL_CAPTURE=false

## P5: disabled by default. Use a dedicated integration encryption secret.
INTEGRATION_KEY_SECRET=
P5_PUBLIC_ORIGIN=
ONLINE_PAYMENTS_ENABLED=false
INBOUND_MAIL_ENABLED=false
## Declare true only after the deployment firewall restricts the Postmark route
## to published provider IPs. The application does not authenticate X-Forwarded-For.
POSTMARK_INGRESS_IP_FILTER_CONFIGURED=false
## Public origin must use HTTPS. Your private ingress must overwrite
## X-Forwarded-Proto and block direct public access to the application port.
## Stripe keys, webhook secrets and Postmark Basic credentials are entered in
## each company's protected Automation settings, never shared across companies.
